---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="Acceso administrador | NOOKIS">
  <main class="relative flex min-h-screen items-center justify-center overflow-hidden bg-plum-950 px-6 py-12">
    <div class="grain absolute inset-0"></div>
    <a href="/" class="absolute left-6 top-6 font-display text-2xl tracking-[0.08em] text-cream sm:left-10">NOOKIS<span class="text-coral">.</span></a>
    <section class="glass-panel relative w-full max-w-md rounded-3xl p-8 sm:p-10">
      <p class="text-[10px] font-semibold uppercase tracking-[0.4em] text-rose">Panel privado</p>
      <h1 class="editorial-title mt-4 text-6xl text-cream">Bienvenido</h1>
      <p class="mt-4 text-sm leading-relaxed text-cream/60">Inicia sesión para administrar las reservas de tu restaurante.</p>
      <form id="login-form" class="mt-8 space-y-5" novalidate>
        <label class="block space-y-2 text-sm text-cream/75">Usuario
          <input name="usuario" autocomplete="username" required maxlength="15" class="w-full rounded-xl border border-cream/15 bg-plum-950/60 px-4 py-3 text-cream placeholder:text-cream/35" placeholder="sabinofc" />
          <span data-error="usuario" class="text-xs text-coral"></span>
        </label>
        <label class="block space-y-2 text-sm text-cream/75">Contraseña
          <input name="contrasena" autocomplete="current-password" type="password" required class="w-full rounded-xl border border-cream/15 bg-plum-950/60 px-4 py-3 text-cream placeholder:text-cream/35" placeholder="••••••••" />
          <span data-error="contrasena" class="text-xs text-coral"></span>
        </label>
        <button type="submit" class="w-full rounded-full bg-coral px-6 py-3.5 font-semibold text-plum-950 transition hover:bg-cream">Entrar al panel</button>
        <p id="login-message" class="hidden text-center text-sm" role="alert"></p>
      </form>
    </section>
  </main>
  <script>
    import { loginFormSchema } from '../schemas/forms'
    import { login } from '../lib/api/auth'
    import { isAuthenticated } from '../lib/session'

    const form = document.querySelector<HTMLFormElement>('#login-form')
    const message = document.querySelector<HTMLElement>('#login-message')

    if (isAuthenticated()) window.location.replace('/admin/reservas')

    form?.addEventListener('submit', async (event) => {
      event.preventDefault()
      if (!form || !message) return
      document.querySelectorAll('[data-error]').forEach((element) => element.textContent = '')
      message.className = 'hidden text-center text-sm'

      const values = Object.fromEntries(new FormData(form).entries())
      const parsed = loginFormSchema.safeParse(values)
      if (!parsed.success) {
        parsed.error.issues.forEach((issue) => {
          const field = issue.path[0]
          const target = document.querySelector<HTMLElement>(`[data-error="${field}"]`)
          if (target) target.textContent = issue.message
        })
        return
      }

      try {
        await login(parsed.data.usuario, parsed.data.contrasena)
        window.location.assign('/admin/reservas')
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : 'No fue posible iniciar sesión'
        message.className = 'text-center text-sm text-coral'
      }
    })
  </script>
</BaseLayout>
