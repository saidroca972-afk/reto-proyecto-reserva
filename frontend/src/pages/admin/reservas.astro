---
import BaseLayout from '../../layouts/BaseLayout.astro'
import ReservationForm from '../../components/ReservationForm.astro'
---
<BaseLayout title="Reservas | Panel administrador">
  <main class="min-h-screen bg-plum-950 px-5 py-6 text-cream sm:px-8 lg:px-12">
    <header class="mx-auto flex max-w-7xl items-center justify-between border-b border-cream/10 pb-6">
      <a href="/" class="font-display text-2xl tracking-[0.08em]">NOOKIS<span class="text-coral">.</span></a>
      <button id="logout-button" class="rounded-full border border-cream/25 px-4 py-2 text-xs font-semibold uppercase tracking-[0.15em] text-cream/80 transition hover:border-coral hover:text-coral">Cerrar sesión</button>
    </header>
    <section class="mx-auto max-w-7xl py-10">
      <div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.4em] text-rose">Administración</p>
          <h1 class="editorial-title mt-3 text-6xl text-cream sm:text-7xl">Tus reservas</h1>
        </div>
        <button id="new-reservation-button" class="rounded-full bg-coral px-6 py-3 text-sm font-semibold text-plum-950 transition hover:bg-cream">+ Nueva reserva</button>
      </div>
      <div class="glass-panel mb-6 rounded-2xl p-4">
        <form id="filters-form" class="grid gap-3 md:grid-cols-[1fr_180px_150px_160px_160px_auto]">
          <input name="nombreCliente" class="rounded-xl border border-cream/15 bg-plum-950/60 px-4 py-3 text-sm text-cream placeholder:text-cream/35" placeholder="Buscar por cliente" />
          <select name="estado" class="rounded-xl border border-cream/15 bg-plum-950/60 px-4 py-3 text-sm text-cream"><option value="">Todos los estados</option><option value="Disponible">Disponible</option><option value="Cancelado">Cancelado</option></select>
          <input name="numeroMesa" type="number" min="1" class="rounded-xl border border-cream/15 bg-plum-950/60 px-4 py-3 text-sm text-cream placeholder:text-cream/35" placeholder="Mesa" />
          <input name="fechaDesde" type="date" class="rounded-xl border border-cream/15 bg-plum-950/60 px-4 py-3 text-sm text-cream" aria-label="Fecha desde" />
          <input name="fechaHasta" type="date" class="rounded-xl border border-cream/15 bg-plum-950/60 px-4 py-3 text-sm text-cream" aria-label="Fecha hasta" />
          <button class="rounded-xl border border-cream/25 px-5 py-3 text-sm text-cream transition hover:border-coral hover:text-coral" type="submit">Filtrar</button>
        </form>
      </div>
      <div id="table-message" class="mb-4 hidden rounded-xl border border-coral/40 bg-coral/10 p-4 text-sm text-coral" role="alert"></div>
      <div class="glass-panel overflow-x-auto rounded-2xl">
        <table class="w-full min-w-[700px] text-left text-sm">
          <thead class="border-b border-cream/10 text-xs uppercase tracking-[0.15em] text-cream/45"><tr><th class="px-5 py-4">Cliente</th><th class="px-5 py-4">Teléfono</th><th class="px-5 py-4">Mesa</th><th class="px-5 py-4">Fecha</th><th class="px-5 py-4">Estado</th><th class="px-5 py-4">Acción</th></tr></thead>
          <tbody id="reservations-body"></tbody>
        </table>
        <div id="empty-state" class="hidden p-10 text-center text-cream/55">No hay reservas para mostrar.</div>
      </div>
    </section>
    <div id="modal" class="fixed inset-0 z-30 hidden items-center justify-center bg-plum-950/80 px-5 py-8 backdrop-blur-sm">
      <section class="glass-panel max-h-[90vh] w-full max-w-2xl overflow-y-auto rounded-3xl p-6 sm:p-8"><div class="mb-6 flex items-center justify-between"><h2 class="font-display text-4xl text-cream">Nueva reserva</h2><button id="close-modal" class="text-2xl text-cream/60 hover:text-coral" aria-label="Cerrar">×</button></div><ReservationForm /></section>
    </div>
  </main>
  <script>
    import { reservationFormSchema } from '../../schemas/forms'
    import { createReservation, listReservations, updateReservation } from '../../lib/api/reservas'
    import { logout } from '../../lib/api/auth'
    import { isAuthenticated } from '../../lib/session'
    import type { Reservation, ReservationFilters } from '../../types/api'

    if (!isAuthenticated()) window.location.replace('/login')

    const body = document.querySelector<HTMLTableSectionElement>('#reservations-body')
    const empty = document.querySelector<HTMLElement>('#empty-state')
    const tableMessage = document.querySelector<HTMLElement>('#table-message')
    const modal = document.querySelector<HTMLElement>('#modal')
    const form = document.querySelector<HTMLFormElement>('#reservation-form')
    const formMessage = document.querySelector<HTMLElement>('#form-message')
    let editingId: number | null = null
    let currentReservations: Reservation[] = []

    function showError(message: string) {
      if (!tableMessage) return
      tableMessage.textContent = message
      tableMessage.classList.remove('hidden')
    }

    function render(reservations: Reservation[]) {
      if (!body || !empty) return
      currentReservations = reservations
      body.innerHTML = reservations.map((reservation) => `
        <tr class="border-b border-cream/5 text-cream/80 last:border-0">
          <td class="px-5 py-4 font-medium text-cream">${escapeHtml(reservation.nombreCliente)}</td>
          <td class="px-5 py-4">${escapeHtml(reservation.numeroCliente)}</td>
          <td class="px-5 py-4">Mesa ${reservation.numeroMesa}</td>
          <td class="px-5 py-4">${formatDate(reservation.fechaReserva)}</td>
          <td class="px-5 py-4"><span class="rounded-full px-3 py-1 text-xs ${reservation.estadoPedido === 'Disponible' ? 'bg-olive/25 text-[#b7c58b]' : 'bg-rose/20 text-rose'}">${reservation.estadoPedido}</span></td>
          <td class="px-5 py-4"><button data-edit="${reservation.id}" class="text-xs text-coral hover:text-cream">Editar</button></td>
        </tr>`).join('')
      empty.classList.toggle('hidden', reservations.length > 0)
    }

    function escapeHtml(value: string) { return value.replace(/[&<>'"]/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#039;', '"': '&quot;' }[character] || character)) }
    function formatDate(value: string) { return new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) }
    function toDatetimeLocal(value: string) {
      const date = new Date(value)
      const offset = date.getTimezoneOffset() * 60000
      return new Date(date.getTime() - offset).toISOString().slice(0, 16)
    }
    function openForEdit(reservation: Reservation) {
      if (!form || !modal) return
      editingId = reservation.id
      ;(form.elements.namedItem('nombreCliente') as HTMLInputElement).value = reservation.nombreCliente
      ;(form.elements.namedItem('numeroCliente') as HTMLInputElement).value = reservation.numeroCliente
      ;(form.elements.namedItem('numeroMesa') as HTMLInputElement).value = String(reservation.numeroMesa)
      ;(form.elements.namedItem('estadoPedido') as HTMLSelectElement).value = reservation.estadoPedido
      ;(form.elements.namedItem('fechaReserva') as HTMLInputElement).value = toDatetimeLocal(reservation.fechaReserva)
      modal.classList.replace('hidden', 'flex')
    }

    async function load(filters: ReservationFilters = {}) {
      try { tableMessage?.classList.add('hidden'); render(await listReservations(filters)) }
      catch (error) { if ((error as { status?: number }).status === 401) window.location.replace('/login'); else showError(error instanceof Error ? error.message : 'No se pudieron cargar las reservas') }
    }

    document.querySelector('#filters-form')?.addEventListener('submit', (event) => {
      event.preventDefault()
      const values = Object.fromEntries(new FormData(event.currentTarget as HTMLFormElement).entries())
      load({
        estado: values.estado as ReservationFilters['estado'] || undefined,
        nombreCliente: String(values.nombreCliente || '') || undefined,
        numeroMesa: values.numeroMesa ? Number(values.numeroMesa) : undefined,
        fechaDesde: values.fechaDesde ? `${String(values.fechaDesde)}T00:00:00.000Z` : undefined,
        fechaHasta: values.fechaHasta ? `${String(values.fechaHasta)}T23:59:59.999Z` : undefined,
      })
    })
    document.querySelector('#new-reservation-button')?.addEventListener('click', () => { editingId = null; form?.reset(); if (formMessage) formMessage.className = 'hidden text-sm'; modal?.classList.replace('hidden', 'flex') })
    document.querySelector('#close-modal')?.addEventListener('click', () => { editingId = null; modal?.classList.replace('flex', 'hidden') })
    document.querySelector('#logout-button')?.addEventListener('click', async () => { await logout(); window.location.replace('/login') })
    body?.addEventListener('click', (event) => { const target = event.target as HTMLElement; const id = target.dataset.edit; if (id) { const reservation = currentReservations.find((item) => item.id === Number(id)); if (reservation) openForEdit(reservation) } })
    form?.addEventListener('submit', async (event) => {
      event.preventDefault(); if (!form || !formMessage) return
      const values = Object.fromEntries(new FormData(form).entries())
      const parsed = reservationFormSchema.safeParse(values)
      if (!parsed.success) { formMessage.textContent = parsed.error.issues[0]?.message || 'Revisa los datos'; formMessage.className = 'text-sm text-coral'; return }
      try {
        const payload = { ...parsed.data, numeroMesa: Number(parsed.data.numeroMesa), fechaReserva: parsed.data.fechaReserva ? new Date(parsed.data.fechaReserva).toISOString() : undefined }
        if (editingId) await updateReservation(editingId, payload)
        else await createReservation(payload)
        formMessage.textContent = editingId ? 'Reserva actualizada correctamente' : 'Reserva guardada correctamente'
        formMessage.className = 'text-sm text-[#b7c58b]'
        editingId = null
        form.reset()
        await load()
        setTimeout(() => modal?.classList.replace('flex', 'hidden'), 700)
      }
      catch (error) { formMessage.textContent = error instanceof Error ? error.message : 'No se pudo guardar la reserva'; formMessage.className = 'text-sm text-coral' }
    })

    load()
  </script>
</BaseLayout>
